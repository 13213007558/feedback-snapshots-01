-- Minimal security-message schema for the Python/C decoder differential
-- regression. Uses only features supported by both the asn1tools Python
-- codecs and the generated C decoders (OER and UPER): constrained
-- integers, nested CHOICE, variable-length arrays and optional fields.
SecMsg DEFINITIONS AUTOMATIC TAGS ::= BEGIN
    SecMsg ::= SEQUENCE {
        version     INTEGER (0..7),
        msgId       INTEGER (0..4294967295),
        body        Body,
        trustAnchor OCTET STRING (SIZE (8)) OPTIONAL,
        priority    INTEGER (0..255) OPTIONAL
    }

    Body ::= CHOICE {
        signedData SignedBody,
        plain      PlainBody,
        control    ControlBody
    }

    SignedBody ::= SEQUENCE {
        signerDigest OCTET STRING (SIZE (8)),
        signature    OCTET STRING (SIZE (4)),
        content      Content
    }

    Content ::= CHOICE {
        text  OCTET STRING (SIZE (1..8)),
        raw   OCTET STRING (SIZE (2)),
        empty BOOLEAN
    }

    PlainBody ::= SEQUENCE {
        recipients SEQUENCE (SIZE (0..4)) OF INTEGER (0..65535),
        urgent     BOOLEAN
    }

    ControlBody ::= SEQUENCE {
        command INTEGER (0..3),
        params  SEQUENCE (SIZE (1..3)) OF Param
    }

    Param ::= SEQUENCE {
        key   INTEGER (0..255),
        value INTEGER (-32768..32767)
    }
END
