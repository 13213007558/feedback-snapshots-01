% DHCP lease evidence monitor

+ Offline lease evidence analysis from byte transcripts

= Same xid reused by different clients
~ dhcp lease_monitor
load_contrib("dhcp_lease_monitor")
from scapy.contrib.dhcp_lease_monitor import (
    CapturedFrame, DhcpLeaseEvidenceAnalyzer, DhcpLeaseMonitorConfig)

BASE = 1700000000.0
CFG = DhcpLeaseMonitorConfig(
    server_ports={"uplink-server"}, relay_ports={"uplink-relay"},
    trusted_servers={"10.0.0.10"}, known_relays={"10.0.1.1"},
    now=BASE + 100)

def run(transcript):
    frames = [CapturedFrame(bytes.fromhex(raw), port, ts)
              for raw, port, ts in transcript]
    return DhcpLeaseEvidenceAnalyzer(CFG).analyze(frames)


xid_collision = [
    ("",
     "access-1", 1700000001.0),
    ("",
     "access-2", 1700000002.0),
]


rep = run(xid_collision)
len(rep.bindings) == 0 and \
    [a.kind for a in rep.alerts] == ["xid-shared-by-multiple-clients"] and \
    rep.alerts[0].positions == (0, 1) and len(rep.incomplete) == 2


= Forged Option 82 on a non-relay port
~ dhcp lease_monitor
forged_opt82 = [
    ("",
     "access-1", 1700000003.0),
]


rep = run(forged_opt82)
len(rep.bindings) == 0 and \
    [a.kind for a in rep.alerts] == ["untrusted-relay-context"] and \
    rep.alerts[0].positions == (0,)


= ACK from a server the client never selected
~ dhcp lease_monitor
unselected_ack = [
    ("",
     "access-1", 1700000004.0),
    ("",
     "uplink-server", 1700000005.0),
    ("",
     "access-1", 1700000006.0),
    ("",
     "uplink-server", 1700000007.0),
]


rep = run(unselected_ack)
len(rep.bindings) == 0 and \
    [a.kind for a in rep.alerts] == ["ack-from-unselected-server"] and \
    rep.alerts[0].positions == (2, 3)


= Legitimate relayed four-way exchange yields a binding
~ dhcp lease_monitor
legit_relay = [
    ("",
     "uplink-relay", 1700000008.0),
    ("",
     "uplink-relay", 1700000009.0),
    ("",
     "uplink-relay", 1700000010.0),
    ("",
     "uplink-relay", 1700000011.0),
]


rep = run(legit_relay)
b = rep.bindings[0]
len(rep.bindings) == 1 and not rep.alerts and not rep.incomplete and \
    b.address == "10.0.0.60" and b.server == "10.0.0.10" and \
    b.phase == "initial" and b.giaddr == "10.0.1.1" and \
    b.positions == (0, 1, 2, 3) and b.lease_time == 7200 and \
    b.remaining(CFG.now) == 7200 - 89


= Renewal and half-observed exchange
~ dhcp lease_monitor
renewal_and_half = [
    ("",
     "access-1", 1700000012.0),
    ("",
     "uplink-server", 1700000013.0),
    ("",
     "access-2", 1700000014.0),
]


rep = run(renewal_and_half)
b = rep.bindings[0]
len(rep.bindings) == 1 and b.phase == "renewal" and \
    b.positions == (0, 1) and not rep.alerts and \
    len(rep.incomplete) == 1
