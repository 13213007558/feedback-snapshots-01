<section>
  <header>
    <% @page_title = "#{t('RejectedRetries')} (#{@total_size})" %>
    <h1><%= t('RejectedRetries') %></h1>
    <% if @rejected.size > 0 && @total_size > @count %>
      <%= erb :_paging, locals: { url: "#{root_path}rejected" } %>
    <% end %>
    <%= filtering('rejected', placeholder_key: "AnyJobContent", label_key: "Filter") %>
  </header>

  <% if @rejected.size > 0 %>
    <form action="<%= root_path %>rejected" method="post">
      <%= csrf_tag %>
      <div class="table_container">
        <table>
          <thead>
            <tr>
              <th>
                <label>
                  <input type="checkbox" class="check_all check-all-items">
                </label>
              </th>
              <th><%= t('RejectedAt') %></th>
              <th><%= t('RetryCount') %></th>
              <th><%= t('Queue') %></th>
              <th><%= t('Job') %></th>
              <th><%= t('Arguments') %></th>
              <th><%= t('RejectionReason') %></th>
              <th><%= t('Error') %></th>
            </tr>
          </thead>
          <% @rejected.each do |entry| %>
            <tr>
              <td>
                <label>
                  <input type="checkbox" name="key[]" value="<%= job_params(entry.item, entry.score) %>" class="shift_clickable select-item-checkbox">
                </label>
              </td>
              <td>
                <a href="<%= root_path %>rejected/<%= job_params(entry.item, entry.score) %>"><%= relative_time(entry.at) %></a>
              </td>
              <td><%= h entry['retry_count'] %></td>
              <td>
                <a href="<%= root_path %>queues/<%= CGI.escape(entry.queue.to_s) %>"><%= h entry.queue %></a>
              </td>
              <td>
                <%= h entry.display_class %>
                <%= display_tags(entry, "rejected") %>
              </td>
              <td>
                <code>
                  <div class="args"><%= display_args(entry.display_args) %></div>
                </code>
              </td>
              <td>
                <a href="<%= root_path %>rejected/<%= job_params(entry.item, entry.score) %>"><%= h truncate(entry['rejection_reason'].to_s, 80) %></a>
                <% if entry['required_capability'] %>
                  <div><small><%= h Array(entry['required_capability']).join(",") %> → <%= h Array(entry['actual_capability']).join(", ") %></small></div>
                <% end %>
              </td>
              <td>
                <div><%= h truncate("#{entry['error_class']}: #{entry['error_message']}", 200) %></div>
              </td>
            </tr>
          <% end %>
        </table>
      </div>
      <div class="buttons-row">
        <input class="btn btn-primary" type="submit" name="retry" value="<%= t('RetryNow') %>">
        <input class="btn btn-danger" type="submit" name="delete" value="<%= t('Delete') %>">
        <input class="btn btn-danger" type="submit" name="kill" value="<%= t('Kill') %>">
        <button class="btn btn-primary bulk-action-buttons bulk-lead-button" type="submit" name="action" value="retry_all" formaction="<%= "#{root_path}rejected/all/retry" %>"><%= t('RetryAll') %></button>
        <button class="btn btn-danger bulk-action-buttons" type="submit" name="action" value="delete_all" formaction="<%= "#{root_path}rejected/all/delete" %>" data-confirm="<%= t('AreYouSure') %>"><%= t('DeleteAll') %></button>
        <button class="btn btn-danger bulk-action-buttons" type="submit" name="action" value="kill_all" formaction="<%= "#{root_path}rejected/all/kill" %>"><%= t('KillAll') %></button>
      </div>
    </form>
  <% else %>
    <div class="alert alert-success"><%= t('NoRejectedRetriesFound') %></div>
  <% end %>
</section>
