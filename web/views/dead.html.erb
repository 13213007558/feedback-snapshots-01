<%= erb :_job_info, locals: { job: @dead, type: :dead } %>

<section>
  <header>
    <h1><%= t('Error') %></h1>
  </header>
  <div class="table_container">
    <table>
      <tbody>
        <tr>
          <th><%= t('ErrorClass') %></th>
          <td>
            <code><%= h @dead['error_class'] %></code>
          </td>
        </tr>
        <tr>
          <th><%= t('ErrorMessage') %></th>
          <td><%= h(@dead['error_message']) %></td>
        </tr>
        <% if @dead.error_backtrace %>
          <tr>
            <th><%= t('ErrorBacktrace') %></th>
            <td>
              <code><%= @dead.error_backtrace.join("<br/>") %></code>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <form action="<%= root_path %>morgue/<%= job_token(@dead, :dead) %>" method="post">
    <%= csrf_tag %>
    <% permitted = permitted_entry_actions(@dead, :dead) %>
    <a class="btn btn-default" href="<%= root_path %>morgue"><%= t('GoBack') %></a>
    <% if permitted.include?(:retry) %><input class="btn btn-primary" type="submit" name="retry" value="<%= t('RetryNow') %>"><% end %>
    <% if permitted.include?(:cancel) %><input class="btn btn-danger" type="submit" name="delete" value="<%= t('Delete') %>"><% end %>
  </form>
</section>
