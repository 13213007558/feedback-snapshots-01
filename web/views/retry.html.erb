<%= erb :_job_info, locals: { job: @retry, type: :retry } %>

<section>
  <header>
    <h2><%= t('Error') %></h2>
  </header>

  <div class="table_container">
    <table>
      <tbody>
        <tr>
          <th><%= t('ErrorClass') %></th>
          <td>
            <code><%= h @retry['error_class'] %></code>
          </td>
        </tr>
        <tr>
          <th><%= t('ErrorMessage') %></th>
          <td><%= h(@retry['error_message']) %></td>
        </tr>
        <% if @retry.error_backtrace %>
          <tr>
            <th><%= t('ErrorBacktrace') %></th>
            <td>
              <code><%= @retry.error_backtrace.join("<br/>") %></code>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <form action="<%= root_path %>retries/<%= job_token(@retry, :retry) %>" method="post">
    <%= csrf_tag %>
    <% permitted = permitted_entry_actions(@retry, :retry) %>
    <a class="btn btn-default" href="<%= root_path %>retries"><%= t('GoBack') %></a>
    <% if permitted.include?(:retry) %><input class="btn btn-primary" type="submit" name="retry" value="<%= t('RetryNow') %>"><% end %>
    <% if permitted.include?(:cancel) %><input class="btn btn-danger" type="submit" name="delete" value="<%= t('Delete') %>"><% end %>
  </form>
</section>
